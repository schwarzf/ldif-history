# 2025-05-12 – Umstrukturierung: Aus „IT-Betrieb“ wird „Plattform“
# Die OU wird umbenannt; alle Personen darunter erhalten damit einen neuen DN.

dn: ou=IT-Betrieb,ou=Personen,dc=beispiel,dc=de
changetype: modrdn
newrdn: ou=Plattform
deleteoldrdn: 1

dn: ou=Plattform,ou=Personen,dc=beispiel,dc=de
changetype: modify
replace: description
description: Plattform-Team (Infrastruktur, Cloud und Support)
-

dn: uid=rbauer,ou=Plattform,ou=Personen,dc=beispiel,dc=de
changetype: modify
replace: title
title: Teamleiter Plattform
-

dn: uid=nrichter,ou=Plattform,ou=Personen,dc=beispiel,dc=de
changetype: modify
replace: title
title: Plattform-Engineerin
-
replace: manager
manager: uid=rbauer,ou=Plattform,ou=Personen,dc=beispiel,dc=de
-

dn: uid=ezimmermann,ou=Plattform,ou=Personen,dc=beispiel,dc=de
changetype: modify
replace: manager
manager: uid=rbauer,ou=Plattform,ou=Personen,dc=beispiel,dc=de
-

# Gruppe umbenennen und Mitglieder auf die neuen DNs umstellen
dn: cn=it-admins,ou=Gruppen,dc=beispiel,dc=de
changetype: modrdn
newrdn: cn=plattform-admins
deleteoldrdn: 1

dn: cn=plattform-admins,ou=Gruppen,dc=beispiel,dc=de
changetype: modify
replace: member
member: uid=rbauer,ou=Plattform,ou=Personen,dc=beispiel,dc=de
member: uid=nrichter,ou=Plattform,ou=Personen,dc=beispiel,dc=de
-
replace: description
description: Administrative Rechte auf der Plattform
-

dn: cn=alle-mitarbeiter,ou=Gruppen,dc=beispiel,dc=de
changetype: modify
delete: member
member: uid=rbauer,ou=IT-Betrieb,ou=Personen,dc=beispiel,dc=de
member: uid=nrichter,ou=IT-Betrieb,ou=Personen,dc=beispiel,dc=de
member: uid=ezimmermann,ou=IT-Betrieb,ou=Personen,dc=beispiel,dc=de
-
add: member
member: uid=rbauer,ou=Plattform,ou=Personen,dc=beispiel,dc=de
member: uid=nrichter,ou=Plattform,ou=Personen,dc=beispiel,dc=de
member: uid=ezimmermann,ou=Plattform,ou=Personen,dc=beispiel,dc=de
-

dn: cn=vpn-nutzer,ou=Gruppen,dc=beispiel,dc=de
changetype: modify
delete: member
member: uid=rbauer,ou=IT-Betrieb,ou=Personen,dc=beispiel,dc=de
