-
add: member
member: uid=rbauer,ou=Plattform,ou=Personen,dc=beispiel,dc=de
member: uid=nrichter,ou=Plattform,ou=Personen,dc=beispiel,dc=de
-

dn: cn=fuehrungskraefte,ou=Gruppen,dc=beispiel,dc=de
changetype: modify
delete: member
member: uid=rbauer,ou=IT-Betrieb,ou=Personen,dc=beispiel,dc=de
