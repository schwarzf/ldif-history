# 2025-03-10 – Namensänderung nach Heirat: Anna Müller heißt jetzt Anna Schmidt
# Die uid wird angepasst, die alte Mailadresse bleibt als Alias erhalten.

dn: uid=amueller,ou=Vertrieb,ou=Personen,dc=beispiel,dc=de
changetype: modrdn
newrdn: uid=aschmidt
deleteoldrdn: 1

dn: uid=aschmidt,ou=Vertrieb,ou=Personen,dc=beispiel,dc=de
changetype: modify
replace: sn
sn: Schmidt
-
replace: cn
cn: Anna Schmidt
-
replace: displayName
displayName: Anna Schmidt
-
add: mail
mail: anna.schmidt@beispiel.de
-

dn: cn=vertrieb,ou=Gruppen,dc=beispiel,dc=de
changetype: modify
